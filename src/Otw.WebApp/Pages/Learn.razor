@page "/learn"
@using Microsoft.Extensions.Localization
@using Otw.Core.Application.Learn
@using Otw.Core.Application.Settings
@using Otw.Core.Domain

@inject IStringLocalizer<Resources.Pages.Learn> Loc

@inject IGetLearnLastWordQueryHandler LastWordHandler
@inject IGetLearnSortTypeQueryHandler SortTypeHandler
@inject IGetLearnProgressQueryHandler ProgressHandler
@inject IMoveLearnNextWordCmdHandler NextWordHandler
@inject IMoveLearnPrevWordCmdHandler PreviousWordHandler

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h3 class="text-center mb-4">@Loc["Title"]</h3>
            
            @if (_currentWord is not null)
            {
                if (_sortType != WordSortType.Random)
                {
                    <div class="progress mb-4" role="progressbar" aria-label="@Loc["Progress"]"
                         aria-valuenow="@_progressPercent.Item2" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @_progressPercent.Item2%">@_progressPercent.Item2%</div>
                    </div>
                }

                <div class="card shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title display-2 text-primary">@_currentWord.Value</h5>
                        <p class="card-text fs-3 mb-4 text-success">@_currentWord.Translation</p>
                        
                        <div class="d-flex justify-content-between gap-2">
                            @if (_sortType != WordSortType.Random)
                            {
                                <button class="btn btn-secondary flex-grow-1"
                                        @onclick="LoadPreviousWord"
                                        disabled="@(_progressPercent.Item1 == 0)">
                                    <i class="bi bi-arrow-left"></i> @Loc["PreviousWord"]
                                </button>
                            }
                            <button class="btn btn-primary flex-grow-1" @onclick="LoadNextWord">
                                @Loc["NextWord"] <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center mt-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@Loc["Loading"]</span>
                    </div>
                    <p class="mt-3 text-muted">@Loc["LoadingData"]</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private WordEntity? _currentWord;
    private (double, int) _progressPercent;
    private WordSortType? _sortType;

    protected override async Task OnInitializedAsync()
    {
        _currentWord = await LastWordHandler.ExecuteAsync();
        _progressPercent = await ProgressHandler.ExecuteAsync(_currentWord.Id);
        _sortType = await SortTypeHandler.ExecuteAsync();
    }

    private async Task LoadNextWord()
    {
        if (_currentWord is not null)
        {
            _currentWord = await NextWordHandler.ExecuteAsync(_currentWord.Id);
            _progressPercent = await ProgressHandler.ExecuteAsync(_currentWord.Id);
        }
    }
    
    private async Task LoadPreviousWord()
    {
        if (_currentWord is not null)
        {
            _currentWord = await PreviousWordHandler.ExecuteAsync(_currentWord.Id);
            _progressPercent = await ProgressHandler.ExecuteAsync(_currentWord.Id);
        }
    }
}
