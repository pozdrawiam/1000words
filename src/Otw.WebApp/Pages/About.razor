@page "/about"
@using Microsoft.Extensions.Localization
@using Otw.Core.Domain

@inject IStringLocalizer<Resources.Pages.About> Loc

@inject NavigationManager Navigation
@inject IParametersRepository Parameters

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h3 class="text-center mb-4">@Loc["Title"]</h3>

            <p class="lead">
                @Loc["DescriptionPart1"]
                <strong>@Loc["DescriptionHighlight"]</strong>.
                @Loc["DescriptionPart2"]
            </p>

            <h3 class="mt-4 mb-3">@Loc["FeaturesTitle"]</h3>
            <ul class="mb-4">
                <li>@Loc["Feature1"]</li>
                <li>@Loc["Feature2"]</li>
                <li>@Loc["Feature3"]</li>
                <li>@Loc["Feature4"]</li>
                <li>@Loc["Feature5"]</li>
            </ul>

            <h3 class="mt-4 mb-3">@Loc["StepsTitle"]</h3>
            <ol class="mb-4">
                <li>@Loc["Step1"]</li>
                <li><strong>@Loc["Step2"]</strong></li>
                <li>@Loc["Step3"]</li>
                <li>@Loc["Step4"]</li>
            </ol>
            
            <div class="text-center mt-4">
                <button class="btn btn-primary btn-lg"
                        @onclick="StartLearning">
                    <i class="bi bi-book"></i> @Loc["StartLearningBtn"]
                </button>
            </div>

            <div class="text-center mt-4">
                <a href="https://github.com/pozdrawiam/1000words"
                   target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-github"></i> @Loc["GitHubLink"]
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private async Task StartLearning()
    {
        await Parameters.SetLearnStartedAsync();
        
        Navigation.NavigateTo("/learn");
    }
}
