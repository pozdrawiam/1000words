@page "/settings"
@using Microsoft.Extensions.Localization
@using Otw.Core.Domain

@inject IStringLocalizer<Resources.Pages.Settings> Loc
@inject Otw.Core.Application.Learn.IResetProgressCmdHandler LearnResetHandler
@inject Otw.Core.Application.Review.IResetProgressCmdHandler ReviewResetHandler
@inject Otw.Core.Application.Settings.ILearnSortTypeQueryHandler LearnSortTypeQueryHandler
@inject Otw.Core.Application.Settings.ISetLearSortTypeCmdHandler SetLearSortTypeCmdHandler
@inject Otw.Core.Application.Settings.IReviewSortTypeQueryHandler ReviewSortTypeQueryHandler
@inject Otw.Core.Application.Settings.ISetReviewSortTypeCmdHandler SetReviewSortTypeCmdHandler
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h3 class="text-center mb-4">@Loc["Title"]</h3>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">Sortowanie słów</h5>
                    
                    <p class="text-muted mb-4">Wybierz sposób sortowania słów dla każdego z trybów.</p>

                    <div class="d-grid gap-3">
                        <div class="p-3 border rounded">
                            <h6 class="mb-3">@Loc["LearnMode"]</h6>
                            <select class="form-select" value="@LearnSortType" @onchange="OnLearnSortTypeChanged">
                                <option value="@WordSortType.Default">Domyślnie</option>
                                <option value="@WordSortType.AlphabeticalAsc">Alfabetycznie (A-Z)</option>
                                <option value="@WordSortType.AlphabeticalDesc">Alfabetycznie (Z-A)</option>
                                <option value="@WordSortType.Random">Losowo</option>
                            </select>
                        </div>

                        <div class="p-3 border rounded">
                            <h6 class="mb-3">@Loc["ReviewMode"]</h6>
                            <select class="form-select" value="@ReviewSortType" @onchange="OnReviewSortTypeChanged">
                                <option value="@WordSortType.Default">Domyślnie</option>
                                <option value="@WordSortType.AlphabeticalAsc">Alfabetycznie (A-Z)</option>
                                <option value="@WordSortType.AlphabeticalDesc">Alfabetycznie (Z-A)</option>
                                <option value="@WordSortType.Random">Losowo</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">@Loc["ResetProgressTitle"]</h5>
                    
                    <p class="text-muted mb-4">@Loc["ResetProgressDescription"]</p>

                    <div class="d-grid gap-3">
                        <div class="d-flex justify-content-between align-items-center p-3 border rounded">
                            <div>
                                <h6 class="mb-1">@Loc["LearnMode"]</h6>
                                <small class="text-muted">@Loc["LearnModeDescription"]</small>
                            </div>
                            <button class="btn btn-outline-danger btn-sm" 
                                    @onclick="ResetLearnProgress">
                                <i class="bi bi-arrow-clockwise"></i> @Loc["Reset"]
                            </button>
                        </div>

                        <div class="d-flex justify-content-between align-items-center p-3 border rounded">
                            <div>
                                <h6 class="mb-1">@Loc["ReviewMode"]</h6>
                                <small class="text-muted">@Loc["ReviewModeDescription"]</small>
                            </div>
                            <button class="btn btn-outline-danger btn-sm" 
                                    @onclick="ResetReviewProgress">
                                <i class="bi bi-arrow-clockwise"></i> @Loc["Reset"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private WordSortType LearnSortType { get; set; }
    private WordSortType ReviewSortType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        LearnSortType = await LearnSortTypeQueryHandler.ExecuteAsync();
        ReviewSortType = await ReviewSortTypeQueryHandler.ExecuteAsync();
    }

    private async Task OnLearnSortTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<WordSortType>(e.Value?.ToString(), out var result))
        {
            LearnSortType = result;
            await SetLearSortTypeCmdHandler.ExecuteAsync(result);
        }
    }

    private async Task OnReviewSortTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<WordSortType>(e.Value?.ToString(), out var result))
        {
            ReviewSortType = result;
            await SetReviewSortTypeCmdHandler.ExecuteAsync(result);
        }
    }

    private async Task ResetLearnProgress()
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", Loc["ResetLearnConfirm"].Value);
        if (confirmed)
        {
            await LearnResetHandler.ExecuteAsync();
            Navigation.NavigateTo("/learn", forceLoad: true);
        }
    }

    private async Task ResetReviewProgress()
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", Loc["ResetReviewConfirm"].Value);
        if (confirmed)
        {
            await ReviewResetHandler.ExecuteAsync();
            Navigation.NavigateTo("/review", forceLoad: true);
        }
    }
}
